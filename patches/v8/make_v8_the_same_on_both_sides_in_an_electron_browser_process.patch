+// An Electron browser process has none of the annotations a renderer has. The
+// driver runs its recorded threads one at a time and keeps its heap at the same
+// addresses on both sides (see the driver's ObjCBridge.h). So it needs V8 to
+// allocate from that heap in the same way on both sides, which a renderer doesn't:
+// the same bytecode and the same flags, with what only runs when replaying keeping
+// out of it, and nothing the GC collects running the embedder's code.
+static bool IsSameOnBothSides();
+
+static void EnterReplayCode();
+static void ExitReplayCode();
+
 static bool HasDivergedFromRecording();
