From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett Lamy <blamy@Bretts-MacBook-Pro.local>
Date: Tue, 3 Nov 2026 03:02:55 -0500
Subject: Make V8 the same on both sides in an Electron browser process

An Electron browser process has none of the annotations a renderer has. The
driver runs its recorded threads one at a time and keeps its heap at the same
addresses on both sides. So when its driver says so, V8 does the same thing on
both sides too, which a renderer's doesn't: the same bytecode, instrumentation
opcodes included, the same flags, and a GC which isn't hidden from the
recording, so that it happens at the same points and so do its weak callbacks.

Also what Node's bindings need, from the copy of V8 in Replay's Node, and hiding
the scripts Node and Electron run for themselves.

diff --git a/include/replayio.h b/include/replayio.h
index db681621110a9bfe66ba09f54cae714059e6dba1..9d9ae10fead71b8f75fa99ed6b6d4e777f05b298 100644
--- a/include/replayio.h
+++ b/include/replayio.h
@@ -25,6 +25,32 @@ struct AutoDisallowEvents {
   ~AutoDisallowEvents() { v8::recordreplay::EndDisallowEvents(); }
 };
 
+// For code which runs at points which differ between recording and replaying,
+// such as the GC. See recordreplay::IsSameOnBothSides.
+struct AutoDisallowNondeterministicEvents {
+  explicit AutoDisallowNondeterministicEvents(const char* label)
+      : active_(v8::recordreplay::ShouldDisallowNondeterministicEvents()) {
+    if (active_) v8::recordreplay::BeginDisallowEventsWithLabel(label);
+  }
+  ~AutoDisallowNondeterministicEvents() {
+    if (active_) v8::recordreplay::EndDisallowEvents();
+  }
+
+  AutoDisallowNondeterministicEvents(const AutoDisallowNondeterministicEvents&) = delete;
+  AutoDisallowNondeterministicEvents& operator=(const AutoDisallowNondeterministicEvents&) = delete;
+
+ private:
+  bool active_;
+};
+
+struct AutoMarkReplayCode {
+  AutoMarkReplayCode() { v8::recordreplay::EnterReplayCode(); }
+  ~AutoMarkReplayCode() { v8::recordreplay::ExitReplayCode(); }
+
+  AutoMarkReplayCode(const AutoMarkReplayCode&) = delete;
+  AutoMarkReplayCode& operator=(const AutoMarkReplayCode&) = delete;
+};
+
 }  // namespace replayio
 }  // namespace v8
 
