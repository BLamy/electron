+// An Electron browser process has none of the annotations a renderer has. The
+// driver runs its recorded threads one at a time and keeps its heap at the same
+// addresses on both sides (see the driver's ObjCBridge.h). So it needs V8 to do
+// exactly the same thing on both sides, which a renderer doesn't: the same
+// bytecode, the same flags, and a GC which isn't hidden from the recording, so
+// that it happens at the same points and so do its weak callbacks.
+static bool IsSameOnBothSides();
+
+// Whether a region of code which doesn't run at the same points on each side
+// has to disallow events. Not when this process is the same on both sides,
+// unless it's running code of ours, or has diverged at a pause.
+static bool ShouldDisallowNondeterministicEvents();
+
+static void EnterReplayCode();
+static void ExitReplayCode();
+
 static bool HasDivergedFromRecording();
 static bool AllowSideEffects();
 
