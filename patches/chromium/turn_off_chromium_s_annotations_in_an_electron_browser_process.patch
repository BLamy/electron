From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett Lamy <blamy@Bretts-MacBook-Pro.local>
Date: Tue, 3 Nov 2026 03:02:57 -0500
Subject: Turn off Chromium's annotations in an Electron browser process

The driver runs its recorded threads one at a time, and it behaves as a stock
browser process does, so it needs none of them. As far as they're concerned it's
not recording, apart from what makes a recording: checkpoints, and finishing it.

diff --git a/base/record_replay.cc b/base/record_replay.cc
index 9e346bcbbcce4c240ae0c9bfff8c3ac8f78b1d8d..ff2045a909f0a13d8ca91383855422e8dccaa98d 100644
--- a/base/record_replay.cc
+++ b/base/record_replay.cc
@@ -226,15 +226,34 @@ ForEachV8APIVoid(DefineFunctionVoid)
 
 #endif // !BUILD_FLAG(IS_WIN)
 
+// An Electron browser process needs none of the annotations in Chromium: the
+// driver runs its recorded threads one at a time, and it behaves as a stock
+// browser process does. So as far as they're concerned it's not recording, apart
+// from what makes a recording: checkpoints, and finishing it. See
+// recordreplay::IsSameOnBothSides in V8.
+#if !BUILDFLAG(IS_WIN)
+extern "C" bool V8RecordReplayIsSameOnBothSides();
+static inline bool Unannotated() {
+  return V8RecordReplayIsSameOnBothSides();
+}
+#else
+static inline bool Unannotated() {
+  return false;
+}
+#endif
+
 bool IsRecordingOrReplaying(const char* feature, const char* subfeature) {
-  return V8IsRecordingOrReplaying(feature, subfeature);
+  return !Unannotated() && V8IsRecordingOrReplaying(feature, subfeature);
 }
 
 bool IsRecording() {
-  return V8IsRecording();
+  return Unannotated() || V8IsRecording();
 }
 
 bool IsReplaying() {
+  if (Unannotated()) {
+    return false;
+  }
   return V8IsReplaying();
 }
 
